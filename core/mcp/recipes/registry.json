{
  "version": 1,
  "recipes": [
    {
      "id": "github",
      "display_name": "GitHub",
      "description": "Search repositories, read files, manage issues + pull requests, and fetch repository metadata via GitHub's official remote MCP server. Sign in with GitHub (OAuth) \u2014 no token to paste \u2014 or supply a personal access token as a fallback.",
      "category": "search",
      "transport": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "auth": {
        "kind": "mcp_oauth",
        "client_id": "Iv23li6LDja9hM0dAJGV",
        "scopes": [
          "repo",
          "read:org",
          "read:user"
        ]
      },
      "primary_auth": "device_code",
      "env_keys": [
        {
          "name": "GITHUB_PERSONAL_ACCESS_TOKEN",
          "display": "GitHub personal access token (optional \u2014 fallback if you don't sign in)",
          "docs_url": "https://github.com/settings/tokens",
          "required": false
        }
      ],
      "config_options": [],
      "capabilities": {
        "tools": true,
        "resources": false,
        "prompts": false,
        "sampling": false
      },
      "docs_url": "https://github.com/github/github-mcp-server",
      "init_timeout_ms": 15000,
      "ping_period_ms": 30000,
      "sampling_policy": {
        "allowed": false,
        "default": false
      }
    },
    {
      "id": "fetch",
