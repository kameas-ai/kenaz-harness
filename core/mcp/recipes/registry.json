{
  "version": 1,
  "recipes": [
    {
      "id": "github",
      "display_name": "GitHub",
      "description": "Search repositories, read files, list issues + pull requests, and fetch repository metadata. Requires a GitHub personal access token.",
      "category": "search",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "env_keys": [
        {
          "name": "GITHUB_TOKEN",
          "display": "GitHub personal access token",
          "docs_url": "https://github.com/settings/tokens",
          "required": true
        }
      ],
      "config_options": [],
      "capabilities": { "tools": true, "resources": false, "prompts": false, "sampling": false },
      "docs_url": "https://github.com/modelcontextprotocol/servers-archived/tree/main/src/github",
      "init_timeout_ms": 10000,
      "ping_period_ms": 30000,
      "sampling_policy": { "allowed": false, "default": false },
      "warning": "npm fetch on first run can take 5–15 s."
    },
    {
      "id": "fetch",
      "display_name": "Fetch (HTTP)",
      "description": "Generic HTTP fetch tool: the model can request a URL and read the response. No credentials required; the recipe imposes no allow-list — limit access via Cedar policy if you need a domain whitelist.",
      "category": "fetch",
      "command": ["npx", "-y", "@modelcontextprotocol/server-fetch"],
      "env_keys": [],
      "config_options": [],
      "capabilities": { "tools": true, "resources": false, "prompts": false, "sampling": false },
      "docs_url": "https://github.com/modelcontextprotocol/servers-archived/tree/main/src/fetch",
      "init_timeout_ms": 10000,
      "ping_period_ms": 30000,
      "sampling_policy": { "allowed": false, "default": false },
      "warning": "npm fetch on first run can take 5–15 s."
    },
    {
      "id": "brave-search",
      "display_name": "Brave Search",
      "description": "Web and local search via the Brave Search API. Requires a Brave Search API key (free tier available).",
      "category": "search",
      "command": ["npx", "-y", "@modelcontextprotocol/server-brave-search"],
      "env_keys": [
        {
          "name": "BRAVE_API_KEY",
          "display": "Brave Search API key",
          "docs_url": "https://api.search.brave.com/app/keys",
          "required": true
        }
      ],
      "config_options": [],
      "capabilities": { "tools": true, "resources": false, "prompts": false, "sampling": false },
      "docs_url": "https://github.com/modelcontextprotocol/servers-archived/tree/main/src/brave-search",
      "init_timeout_ms": 10000,
      "ping_period_ms": 30000,
      "sampling_policy": { "allowed": false, "default": false },
      "warning": "npm fetch on first run can take 5–15 s."
    },
    {
      "id": "sqlite",
      "display_name": "SQLite",
      "description": "Read and write a local SQLite database. The model gets read_query, write_query, create_table, list_tables, and describe_table tools scoped to the database file you point it at.",
      "category": "filesystem",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sqlite", "${DB_PATH}"],
      "env_keys": [],
      "config_options": [
        {
          "name": "db_path",
          "display": "Database file",
          "kind": "string",
          "default": "",
          "required": true,
          "description": "Absolute path to the SQLite database file. The file is created if it does not exist."
        }
      ],
      "capabilities": { "tools": true, "resources": false, "prompts": false, "sampling": false },
      "docs_url": "https://github.com/modelcontextprotocol/servers-archived/tree/main/src/sqlite",
      "init_timeout_ms": 10000,
      "ping_period_ms": 30000,
      "sampling_policy": { "allowed": false, "default": false },
      "warning": "npm fetch on first run can take 5–15 s."
    },
    {
      "id": "postgres",
      "display_name": "PostgreSQL",
      "description": "Read-only access to a PostgreSQL database. The model gets query and schema-introspection tools against the connection string you supply.",
      "category": "filesystem",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres"],
      "env_keys": [
        {
          "name": "POSTGRES_CONNECTION_STRING",
          "display": "Postgres connection string",
          "docs_url": "https://www.postgresql.org/docs/current/libpq-connect.html#LIBPQ-CONNSTRING",
          "required": true
        }
      ],
      "config_options": [],
      "capabilities": { "tools": true, "resources": false, "prompts": false, "sampling": false },
      "docs_url": "https://github.com/modelcontextprotocol/servers-archived/tree/main/src/postgres",
