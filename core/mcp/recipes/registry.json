      "description": "Read git history, diff, blame, and branch metadata for a single repository checkout. The recipe is read-only by default and is scoped to the repo path you select.",
      "category": "filesystem",
      "command": ["npx", "-y", "@modelcontextprotocol/server-git", "--repository", "${REPO_PATH}"],
      "env_keys": [],
      "config_options": [
        {
          "name": "repo_path",
