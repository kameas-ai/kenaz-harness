    {
      "id": "slack",
      "display_name": "Slack",
      "description": "Read channels, post messages, search, and look up users in your Slack workspace via Slack\u2019s official remote MCP server. Sign in with Slack (OAuth + PKCE \u2014 no token to paste). Advanced: supply bot + app-level tokens to use the legacy stdio server instead.",
      "category": "communication",
      "transport": "http",
      "url": "https://mcp.slack.com",
      "auth": {
        "kind": "mcp_oauth",
        "client_id": "",
        "scopes": [
          "channels:read",
          "channels:history",
          "chat:write",
          "users:read",
          "search:read"
        ]
      },
      "headers_template": {
        "Authorization": "Bearer ${SLACK_TOKEN}"
      },
      "env_keys": [],
      "config_options": [],
      "capabilities": {
        "tools": true,
        "resources": false,
        "prompts": false,
        "sampling": false
      },
      "docs_url": "https://api.slack.com/mcp",
      "init_timeout_ms": 15000,
      "ping_period_ms": 30000,
      "sampling_policy": {
        "allowed": false,
        "default": false
      },
      "primary_auth": "oauth",
      "warning": "OAuth sign-in requires the Kameas Slack app to be registered (client_id placeholder \u2014 set KAMEAS_SLACK_OAUTH_CLIENT_ID at build time or register the app and bake the client_id). Advanced: use the token-based stdio server below (id: slack-tokens)."
    },
    {
      "id": "slack-tokens",
      "display_name": "Slack (Advanced: use tokens)",
      "description": "Read channels, post messages, and look up users in a Slack workspace using a bot token and app-level token. Advanced fallback \u2014 prefer the \u2018Slack\u2019 recipe (remote MCP, OAuth sign-in) for token-free setup.",
      "category": "communication",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-slack"
      ],
      "env_keys": [
        {
          "name": "SLACK_BOT_TOKEN",
          "display": "Slack bot token (xoxb-)",
          "docs_url": "https://api.slack.com/concepts/token-types#bot",
          "required": true
        },
        {
          "name": "SLACK_APP_TOKEN",
          "display": "Slack app-level token (xapp-)",
          "docs_url": "https://api.slack.com/concepts/token-types#app-level",
          "required": true
        }
      ],
      "config_options": [],
      "capabilities": {
        "tools": true,
        "resources": false,
        "prompts": false,
        "sampling": false
      },
      "docs_url": "https://github.com/modelcontextprotocol/servers-archived/tree/main/src/slack",
      "init_timeout_ms": 10000,
      "ping_period_ms": 30000,
      "sampling_policy": {
        "allowed": false,
        "default": false
      },
      "warning": "npm fetch on first run can take 5\u201315 s. Prefer the \u2018Slack\u2019 recipe (remote MCP, OAuth sign-in) instead.",
      "primary_auth": "keys"
    },
    {
      "id": "gmail",
      "display_name": "Gmail",
      "description": "Read, search, send, draft, and label Gmail messages through the Gmail API. Requires a Google Cloud OAuth 2.0 credentials file (~/.gmail-mcp/gcp-oauth.keys.json). The install dialog includes a step-by-step guided setup — no command-line work needed.",
      "category": "communication",
      "command": [
        "npx",
        "-y",
        "@gongrzhe/server-gmail-autoauth-mcp"
      ],
      "env_keys": [],
      "config_options": [],
      "capabilities": {
        "tools": true,
        "resources": false,
        "prompts": false,
        "sampling": false
      },
      "docs_url": "https://github.com/GongRzhe/Gmail-MCP-Server",
      "init_timeout_ms": 30000,
      "ping_period_ms": 30000,
      "sampling_policy": {
        "allowed": false,
        "default": false
      },
      "warning": "One-time Google Cloud setup required. The install dialog will guide you through creating an OAuth 2.0 client in the Google Cloud Console and placing the credentials file in ~/.gmail-mcp/. After install the server opens a browser sign-in once to authorize access (credentials cached at ~/.gmail-mcp/credentials.json). First npm fetch can take 10\u201320 s.",
      "primary_auth": "none"
    },
    {
      "id": "outlook",
      "display_name": "Outlook (Microsoft 365)",
      "description": "Read, search, send, and organize Outlook mail \u2014 plus calendar and contacts \u2014 via the Microsoft Graph API. Signs in with a device code in your browser on first use; personal accounts need no credentials.",
      "category": "communication",
      "command": [
        "npx",
        "-y",
        "@softeria/ms-365-mcp-server",
        "--preset",
        "outlook"
      ],
      "primary_auth": "device_code",
      "env_keys": [
        {
          "name": "MS365_MCP_CLIENT_ID",
          "display": "Azure app client ID (optional \u2014 for work/school accounts)",
          "docs_url": "https://github.com/softeria/ms-365-mcp-server#authentication",
          "required": false
        },
        {
          "name": "MS365_MCP_TENANT_ID",
          "display": "Azure tenant ID (optional \u2014 defaults to 'common'; 'consumers' for personal)",
          "docs_url": "https://github.com/softeria/ms-365-mcp-server#authentication",
          "required": false
        }
      ],
      "config_options": [],
      "capabilities": {
        "tools": true,
        "resources": false,
        "prompts": false,
        "sampling": false
      },
      "docs_url": "https://github.com/softeria/ms-365-mcp-server",
      "init_timeout_ms": 30000,
      "ping_period_ms": 30000,
      "sampling_policy": {
        "allowed": false,
        "default": false
      },
      "warning": "First use triggers a device-code sign-in: the server prints a URL + code for you to authorize in your browser. Personal accounts work out of the box; work/school accounts may require a custom Azure app (set the optional client/tenant IDs above). First npm fetch can take 10\u201320 s."
    },
