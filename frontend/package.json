{
  "name": "kenaz-harness-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:served": "BUILD_TARGET=served vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint --ext .ts,.vue,.js src",
    "format": "prettier --write \"src/**/*.{ts,vue,js,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:css-tokens": "node ../scripts/ci/check-css-tokens.mjs",
    "check:bundle-size": "node ../scripts/ci/check-bundle-size.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@kameas-ai/kenaz-design-system": "0.6.1",
    "@sentry/vue": "^10.53.1",
    "@types/dompurify": "^3.0.5",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^12.4.0",
    "dompurify": "^3.4.1",
    "katex": "^0.16.45",
    "lucide-vue-next": "^0.468.0",
    "marked": "^18.0.2",
    "mermaid": "^11.15.0",
    "pdfjs-dist": "^5.7.284",
    "radix-vue": "^1.9.10",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.2",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vitest-axe": "^0.1.0",
    "vue-tsc": "^2.2.0"
  }
}
