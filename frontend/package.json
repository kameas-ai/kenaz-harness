{
  "name": "kaneaz-harness-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint --ext .ts,.vue,.js src",
    "format": "prettier --write \"src/**/*.{ts,vue,js,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:css-tokens": "node ../scripts/ci/check-css-tokens.mjs",
    "check:bundle-size": "node ../scripts/ci/check-bundle-size.mjs"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "@vueuse/core": "^12.4.0",
    "dompurify": "^3.4.1",
    "katex": "^0.16.45",
    "lucide-vue-next": "^0.468.0",
    "marked": "^18.0.2",
    "mermaid": "^11.4.1",
    "radix-vue": "^1.9.10",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.2",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "happy-dom": "^15.11.7",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
